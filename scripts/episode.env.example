# origami-blue episode config — copy next to your work dir, fill in, then: bash cards.sh ep.env / caffeinate -dimsu bash render.sh ep.env
PY=/path/to/venv/bin/python          # python3 with numpy pillow scipy
WORK=/abs/path/work-oct12            # batch work dir: <K>-sdr.mp4, transcripts, zones.json, plates, mattes, cams, cues, wins
PROJ=/abs/path/videos/ep07-full      # HyperFrames project made by new_episode.sh
K=a                                  # footage key inside WORK
EP=07                                # episode number shown on the tile / card labels
DUR=137.47                           # ffprobe duration of <K>-sdr.mp4
TILE="6.56 8.9"                      # seconds the series tile covers the screen ("0 0" if no tile)
KEYWORDS="lead|leads|offer|clear"    # caption words that turn yellow (lowercase)
TRANSCRIPT=a.transcript.json         # or an edited copy (fix mishearings there)
# optional: N (frames, default round(DUR*30)), CARD_TIMES, SLICES ("1100 2700"), FIXES (word-fix json)
APP_NAME="Business Ep 07 - Views vs Trust"   # optional: render.sh adds the finished edit to the HyperFrames desktop app
